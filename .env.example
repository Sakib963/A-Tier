# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # client, read-only via RLS

# Server only. Never expose to the browser. Used for every write.
SUPABASE_SERVICE_ROLE_KEY=

# Single shared admin secret (v1)
ADMIN_PASSCODE=

# Used to sign the admin session cookie. Any long random string.
SESSION_SECRET=
