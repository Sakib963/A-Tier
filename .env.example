# ---------------------------------------------------------------- Supabase
# Project Settings -> API Keys

NEXT_PUBLIC_SUPABASE_URL=

# The public, browser-safe key. Supabase now labels this "publishable"
# (sb_publishable_...); older projects call it "anon" (eyJ...). Either works.
# Read-only in this app: RLS grants anon SELECT and no writes at all.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------- server only
# Never expose these to the browser.

# The "service_role" / secret key. Bypasses RLS, so it is the only thing that
# can write. Needed because this app does not use Supabase Auth: players have
# no login (they pick their name), so there is no auth.uid() for a write
# policy to check. All writes go through our own server routes instead.
SUPABASE_SERVICE_ROLE_KEY=

# Stands in for Supabase Auth on the admin side: one shared passcode (v1).
ADMIN_PASSCODE=

# Signs the admin session cookie so it cannot be forged. Any long random
# string, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
